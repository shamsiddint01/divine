# Divine.uz — production sozlamalari (docker-compose.prod.yml, docs/RUNBOOK.md §1).
# Bu faylda SECRET YO'Q: parollar, kalitlar va URL'lar — secrets/ katalogida (scripts/prod/init-secrets.sh).
# Nusxa: cp .env.prod.example .env.prod

# Sayt domeni (CORS va cookie origin: https://<DOMAIN>)
DOMAIN=erp.example.uz
# Tashqi portlar va interfeys
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Image teglari
APP_VERSION=latest
LOG_LEVEL=info
# Secretlar katalogi (0700)
SECRETS_DIR=./secrets

# Backup (scripts/prod/backup.sh, RUNBOOK §3): shifrlangan nusxalar katalogi, saqlash muddati (kun),
# shifrlash uchun GPG ochiq kaliti (maxfiy kalit serverda SAQLANMAYDI).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT_FILE=./secrets/backup_public_key.asc
# Monitoring (scripts/prod/monitor.sh): xato bo'lsa POST qilinadigan webhook (bo'sh — faqat chiqish kodi)
ALERT_WEBHOOK_URL=
