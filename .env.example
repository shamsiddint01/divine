# ─────────────────────────────────────────────────────────────────────────────
# Divine.uz — environment o'zgaruvchilari namunasi.
# Ishlatish:  cp .env.example .env   va qiymatlarni o'zgartiring.
# .env hech qachon git'ga qo'shilmaydi. Production secretlari faqat deploy muhitida saqlanadi.
# ─────────────────────────────────────────────────────────────────────────────

# --- Umumiy ---
# NODE_ENV bu faylda BERILMAYDI: Vite ham shu .env'ni o'qiydi va NODE_ENV=development
# bo'lsa production build ichiga React'ning dev versiyasi tushadi. API standart holatda
# 'development', testlar 'test', Docker esa 'production' ni o'zi o'rnatadi.
APP_VERSION=0.1.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000
# Vergul bilan ajratilgan aniq originlar ('*' ruxsat etilmaydi).
# Frontend origin'i shu yerda bo'lishi SHART: /auth/refresh va /auth/logout CSRF tekshiruvi Origin'ni shu ro'yxat bilan solishtiradi.
CORS_ORIGINS=http://localhost:5173
# Reverse proxy (Nginx) ortida ishlaganda 1
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Bo'sh qoldirilsa: production'da false, boshqa muhitlarda true
SWAGGER_ENABLED=

# --- PostgreSQL ---
POSTGRES_USER=divine
POSTGRES_PASSWORD=divine_dev_password
POSTGRES_DB=divine
# Host'dagi port (mahalliy PostgreSQL 5432 bilan to'qnashmasligi uchun 5434)
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql://divine:divine_dev_password@localhost:5434/divine?schema=public
# Migratsiyalar uchun sxema egasi (DDL huquqli). Bo'sh bo'lsa DATABASE_URL ishlatiladi (dev'da bitta foydalanuvchi).
# Production: DATABASE_URL — `divine_app` roliga a'zo login, MIGRATION_DATABASE_URL — `divine_owner` (docs/DATABASE.md §6).
MIGRATION_DATABASE_URL=

# --- Redis ---
REDIS_HOST_PORT=6381
REDIS_URL=redis://localhost:6381

# --- Auth (Phase 4) ---
# Har biri kamida 32 belgi, bir-biridan farqli. Yaratish:  openssl rand -base64 48
# 'change-me' bilan boshlanadigan qiymatlar production'da rad etiladi.
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_PEPPER=change-me-password-pepper-min-32-characters
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Refresh cookie'ning Secure belgisi. Production'da false rad etiladi; faqat HTTPS'siz lokal sinov uchun false.
AUTH_COOKIE_SECURE=true

# --- Bootstrap admin (Phase 4) ---
# `pnpm --filter @divine/backend db:bootstrap-admin` uchun standart login (--login berilmasa).
# HTTP endpoint yo'q; parol faqat terminalda bir marta ko'rsatiladi. Seed parol yozmaydi.
SEED_ADMIN_LOGIN=admin

# --- Web (Vite; faqat VITE_ prefiksli o'zgaruvchilar brauzerga chiqadi — secret qo'ymang!) ---
VITE_API_BASE_URL=/api/v1
# API manbai: mock — brauzer ichidagi namunaviy ma'lumotlar (backend kerak emas), http — haqiqiy API
# `vite build` uni aniq talab qiladi (berilmasa build to'xtaydi). Docker web image standarti — http.
VITE_API_MODE=mock
# Backend'da tayyor modullar (/auth/*, /users*, /products*, /product-groups*, /warehouses*, /inventory*, /incoming*, /customers*, /sales*) uchun: http — haqiqiy backend (qolgan biznes sahifalari VITE_API_MODE bo'yicha). VITE_API_MODE=http bo'lsa avtomatik http.
VITE_AUTH_MODE=mock
# Vite dev server /api so'rovlarini shu manzilga proxy qiladi
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
# Frontend dev server porti
WEB_DEV_PORT=5173

# --- Docker (to'liq stack: docker compose --profile app up) ---
WEB_HOST_PORT=8080
