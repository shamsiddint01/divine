{
  "name": "divine-uz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Divine.uz — chakana savdo va bozor bizneslari uchun web ERP",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter @divine/frontend dev",
    "dev:backend": "pnpm --filter @divine/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "coverage": "pnpm -r --workspace-concurrency=1 run coverage",
    "e2e": "pnpm --filter @divine/frontend e2e",
    "ci": "turbo run lint && turbo run typecheck && turbo run test && turbo run test:db && turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres redis",
    "db:deploy": "pnpm --filter @divine/backend db:deploy",
    "db:seed": "pnpm --filter @divine/backend db:seed",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
