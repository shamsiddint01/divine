{
  "name": "@divine/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Divine.uz backend: NestJS REST API",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @divine/shared build && nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "bench:reports": "vitest run --config vitest.bench.config.ts test/bench/reports.bench-spec.ts",
    "bench:load": "vitest run --config vitest.bench.config.ts test/bench/load.bench-spec.ts",
    "bench:compare": "tsx test/bench/compare.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx src/database/seed.cli.ts",
    "db:bootstrap-admin": "tsx src/database/bootstrap-admin.cli.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist .turbo coverage src/generated"
  },
  "dependencies": {
    "@divine/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
