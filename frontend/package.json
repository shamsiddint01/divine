    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
