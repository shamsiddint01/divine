{
  "name": "@divine/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Divine.uz frontend: React SPA (o'zbek tilida)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
